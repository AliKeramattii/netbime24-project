<?xml version="1.0" encoding="utf-8"?>
<!--
  NetBime24 on IIS + iisnode (Plesk Windows).

  Only needed when the Node.js proxy is NOT set up through the Plesk "Node.js" page (which writes
  its own web.config). Copy this file to the site root (httpdocs) as web.config, or merge its
  <handlers>, <iisnode> and <rewrite> parts into the existing one.

  - Static files (index.html, css/, js/, assets/, pages/, shared/) are served by IIS.
  - Every /api/* request is handled by the Node proxy (proxy/iisnode-entry.cjs), which adds the
    backend Bearer token server-side.
  - The proxy/ folder is never downloadable.
  Set NETBIME_PRIVATE_KEY as a server environment variable (Plesk: Node.js > Custom environment
  variables); never put it in a public file.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="proxy/iisnode-entry.cjs" verb="*" modules="iisnode" />
    </handlers>
    <iisnode promoteServerVars="HTTPS" loggingEnabled="false" devErrorsEnabled="false" />
    <rewrite>
      <rules>
        <rule name="NetBime24 block proxy folder" stopProcessing="true">
          <match url="^proxy(/|$)" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <rule name="NetBime24 API proxy" stopProcessing="true">
          <match url="^api(/.*)?$" />
          <action type="Rewrite" url="proxy/iisnode-entry.cjs" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
