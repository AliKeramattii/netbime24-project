# Copy to proxy/.env (git-ignored) or set these as real environment variables on the server.

# Required. Backend privateKey used only by the proxy to request Bearer tokens.
NETBIME_PRIVATE_KEY=

# Backend base URL.
BACKEND_URL=https://api.ramatest.ir

# Listen address. In production run behind HTTPS (IIS/Nginx) and keep this on 127.0.0.1.
HOST=127.0.0.1
PORT=5510

# Folder with the frontend files, relative to proxy/ (default ".."). Set to empty to serve the
# API only, when IIS/Nginx serves the static files and forwards /api/* to this proxy.
# STATIC_ROOT=..

# Upstream request timeout in milliseconds.
UPSTREAM_TIMEOUT_MS=15000
